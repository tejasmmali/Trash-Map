# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings -> API). The URL is public; it is also read server-side.
NEXT_PUBLIC_SUPABASE_URL=
# Reserved for future browser-side reads. The MVP routes all DB access through the server.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Service-role (or "secret") key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for report photos (created by the migration).
SUPABASE_STORAGE_BUCKET=report-images

# Google Gemini API (https://aistudio.google.com/apikey). SERVER ONLY.
GEMINI_API_KEY=
# Must be a Gemma model id that supports image input on your key; verify before relying on it.
GEMINI_MODEL=
